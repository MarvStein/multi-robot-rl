<mujoco model="goal">
  <compiler angle="radian"/>
  <worldbody>
    <!-- Mocap body allows us to teleport the goal easily without physics constraints -->
    <body name="goal" mocap="true" pos="0 0 0">
      <geom type="sphere" size="0.02" mass="0.1" contype="0" conaffinity="0" rgba="1 0 0 0.5"/>
    </body>
  </worldbody>
</mujoco>
