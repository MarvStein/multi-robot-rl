<mujoco model="masspoint">
  <compiler angle="radian"/>
  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <worldbody>
    <body name="masspoint" pos="0 0 0">
        <inertial pos="0.0 0.0 0.0" mass=".01" diaginertia="0.001 0.001 0.001"/>
        
        <!-- We use 2D or 3D sliding joints to give it XYZ control -->
        <joint name="mp_x" pos="0.0 0.0 0.0" axis="1 0 0" type="slide" limited="true" range="-1.0 1.0" damping="1"/>
        <joint name="mp_y" pos="0.0 0.0 0.0" axis="0 1 0" type="slide" limited="true" range="-1.0 1.0" damping="1"/>
        
        <geom rgba="0 0 0 1" size="0.02" type="sphere"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Native velocity actuators -->
    <velocity kv="5" name="mp_x_a" joint="mp_x" ctrllimited="true" ctrlrange="-2 2"/>
    <velocity kv="5" name="mp_y_a" joint="mp_y" ctrllimited="true" ctrlrange="-2 2"/>
  </actuator>
</mujoco>
