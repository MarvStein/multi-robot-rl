<mujoco model="masspoint_3d">
  <compiler angle="radian"/>
  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <worldbody>
    <body name="masspoint" pos="0 0 0">
        <inertial pos="0.0 0.0 0.0" mass="0.01" diaginertia="0.001 0.001 0.001"/>
        <!-- We use 3D sliding joints to give it XYZ control -->
        <joint name="mp_x" pos="0.0 0.0 0.0" axis="1 0 0" type="slide" limited="true" range="{{ MP_XY_RANGE[0] }} {{ MP_XY_RANGE[1] }}" damping="0.1"/>
        <joint name="mp_y" pos="0.0 0.0 0.0" axis="0 1 0" type="slide" limited="true" range="{{ MP_XY_RANGE[0] }} {{ MP_XY_RANGE[1] }}" damping="0.1"/>
        <joint name="mp_z" pos="0.0 0.0 0.0" axis="0 0 1" type="slide" springref="{{ MP_Z_RANGE[1] }}" limited="true" stiffness="0.5" range="{{ MP_Z_RANGE[0] }} {{ MP_Z_RANGE[1] }}" damping="0.1"/>
        <geom rgba="0 0 0 1" size="{{ MP_RADIUS }}" type="sphere" gap="0.0"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Native velocity actuators -->
    <velocity kv="0.5" name="mp_x_a" joint="mp_x" ctrllimited="true" ctrlrange="-1.0 1.0"/>
    <velocity kv="0.5" name="mp_y_a" joint="mp_y" ctrllimited="true" ctrlrange="-1.0 1.0"/>
    <velocity kv="0.5" name="mp_z_a" joint="mp_z" ctrllimited="true" ctrlrange="-1.0 1.0"/>
  </actuator>
</mujoco>
